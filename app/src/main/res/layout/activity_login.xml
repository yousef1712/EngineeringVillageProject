<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/back"
    android:orientation="vertical"
    android:padding="15dp"
    tools:context=".LoginActivity">

    <ImageView
        android:layout_width="200dp"
        android:layout_height="200dp"
        android:layout_gravity="center"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="0dp"
        android:src="@drawable/engener" />


    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="right"
        android:layout_marginRight="20dp"
        android:layout_marginBottom="10dp"
        android:background="@drawable/roundcornerstroke"
        android:fontFamily="@font/cairo_bold"
        android:paddingLeft="30dp"
        android:paddingRight="30dp"
        android:text="الرسالة"
        android:textColor="#2D82D1"
        android:textSize="28sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/cairo_medium"
        android:gravity="right"
        android:paddingLeft="30dp"
        android:paddingRight="30dp"
        android:text="توفير البيئة المناسبة لصقل المهارات العملية واختضان روح الابداع والابتكار من خلال توفير التدريب والخبرة والمختبرات"
        android:textColor="@color/black"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="right"
        android:layout_marginTop="20dp"
        android:layout_marginRight="20dp"
        android:layout_marginBottom="10dp"
        android:background="@drawable/roundcornerstroke"
        android:fontFamily="@font/cairo_bold"
        android:paddingLeft="30dp"
        android:paddingRight="30dp"
        android:text="الأندية"
        android:textColor="#2D82D1"
        android:textSize="28sp"
        android:textStyle="bold" />

    <Button
        android:id="@+id/btProgrammingClub"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="20dp"
        android:layout_marginTop="10dp"
        android:layout_marginRight="20dp"
        android:background="@drawable/roundcornerstroke"
        android:backgroundTint="#FFAE21"
        android:fontFamily="@font/cairo_bold"
        android:text="نادي البرمجة"
        android:textColor="@color/white"
        android:textSize="25sp" />

    <Button
        android:id="@+id/btEngineeringClub"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="20dp"
        android:layout_marginTop="10dp"
        android:layout_marginRight="20dp"
        android:background="@drawable/roundcornerstroke"
        android:backgroundTint="#FFAE21"
        android:fontFamily="@font/cairo_bold"
        android:text="نادي الهندسة"
        android:textColor="@color/white"
        android:textSize="25sp" />

    <Button
        android:id="@+id/btScienceClub"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="20dp"
        android:layout_marginTop="10dp"
        android:layout_marginRight="20dp"
        android:background="@drawable/roundcornerstroke"
        android:backgroundTint="#FFAE21"
        android:fontFamily="@font/cairo_bold"
        android:text="نادي العلوم"
        android:textColor="@color/white"
        android:textSize="25sp" />


</LinearLayout>